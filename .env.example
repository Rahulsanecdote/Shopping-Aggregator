# ============================================================
# Shopping Aggregator — Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Amazon US (PA-API 5.0) --------------------------------
# Sign up at: https://affiliate-program.amazon.com/
# Then access PA-API at: https://webservices.amazon.com/paapi5
AMAZON_US_ACCESS_KEY=
AMAZON_US_SECRET_KEY=
AMAZON_US_ASSOCIATE_TAG=

# ---- Amazon India (PA-API 5.0 - India endpoint) ------------
# Sign up at: https://affiliate-program.amazon.in/
# Separate associate account required for Amazon.in
AMAZON_INDIA_ACCESS_KEY=
AMAZON_INDIA_SECRET_KEY=
AMAZON_INDIA_ASSOCIATE_TAG=

# ---- Flipkart Affiliate API --------------------------------
# Apply at: https://affiliate.flipkart.com/
# Note: Flipkart Affiliate API access is limited — apply early.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
